<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>VRC_OSC_Handy</RootNamespace>
    <AssemblyName>VRC-OSC-Handy</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- These JSON files are loaded directly by MainWindow.genConfig via manifest resources. -->
    <EmbeddedResource Include="resource\config.json" LogicalName="$(RootNamespace).resource.config.json" />
    <EmbeddedResource Include="resource\vrc_config.json" LogicalName="$(RootNamespace).resource.vrc_config.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BuildSoft.OscCore" Version="1.2.1.1" />
    <PackageReference Include="CefSharp.Wpf.NETCore" Version="152.0.60" />
    <PackageReference Include="EmbedIO" Version="3.5.2" />
    <PackageReference Include="log4net" Version="3.4.0" />
    <PackageReference Include="NAudio" Version="2.4.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SpotifyAPI.Web" Version="7.4.2" />
    <PackageReference Include="SpotifyAPI.Web.Auth" Version="7.4.2" />
    <PackageReference Include="Unosquare.Swan.Lite" Version="3.1.0" />
    <PackageReference Include="VRCOscLib" Version="1.6.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Cuda.Windows" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Cuda12.Windows" Version="1.9.1" />
  </ItemGroup>
</Project>
